# Used by Vite to proxy same-origin calls to "/api" to an actual backend instance. Example value here is the URL of
# brilliant_view_backend when running it locally.
VITE_API_URL="http://localhost:4000/api"

# Base URL of the brilliant-view-admin app. Linked from the impersonation banner.
VITE_ADMIN_REDIRECT_URI="http://localhost:7576"
