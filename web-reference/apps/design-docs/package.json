{
    "name": "design-docs",
    "version": "0.3.4",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"pnpm storybook dev -p 6006 --ci\" \"pnpm style-dev\"",
        "style-dev": "tailwindcss -i ./.storybook/tailwind.css -o ./.storybook/styles.css --watch",
        "build": "pnpm style-build && pnpm storybook build --docs",
        "style-build": "tailwindcss -i ./.storybook/tailwind.css -o ./.storybook/styles.css",
        "preview-storybook": "serve storybook-static",
        "clean": "rm -rf .turbo && rm -rf .cache node_modules .turbo storybook-static",
        "lint": "eslint stories --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "format": "prettier --check . !**/*.css --ignore-path ../../.gitignore",
        "build:storybook": "storybook build"
    },
    "dependencies": {
        "@brilliant/bds-core": "workspace:*",
        "@brilliant/components": "workspace:*",
        "@bv/design-tokens": "workspace:*",
        "@bv/ui": "workspace:*",
        "@repo/prettier-config": "workspace:*",
        "@tanstack/react-table": "catalog:",
        "concurrently": "8.2.2",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-router-dom": "6.24.1"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@repo/eslint-config": "workspace:*",
        "@storybook/addon-designs": "^7.0.9",
        "@storybook/addon-a11y": "^7.6.17",
        "@storybook/addon-actions": "^7.6.17",
        "@storybook/addon-essentials": "^7.6.17",
        "@storybook/addon-links": "^7.6.17",
        "@storybook/addon-themes": "^7.6.19",
        "@storybook/blocks": "^7.0.2",
        "@storybook/manager-api": "^8.1.11",
        "@storybook/react": "^7.6.17",
        "@storybook/react-vite": "^7.6.17",
        "@storybook/theming": "^8.1.11",
        "@storybook/test": "^7.6.17",
        "@storybook/addon-interactions": "^7.0.2",
        "@types/react": "catalog:",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.32.0",
        "postcss": "^8.4.41",
        "prettier": "catalog:",
        "serve": "^14.2.1",
        "storybook": "^7.6.17",
        "tailwindcss": "catalog:",
        "@typescript/native": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    },
    "prettier": "@repo/prettier-config"
}
