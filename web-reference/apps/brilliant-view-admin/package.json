{
    "name": "brilliant-view-admin",
    "version": "0.2.4",
    "type": "module",
    "exports": {
        ".": "./tailwind.config.ts"
    },
    "scripts": {
        "dev": "vite --port 7576",
        "dev:arcade": "vite --mode arcade --host 127.0.0.1 --port 7576",
        "build": "tsc && vite build",
        "test": "vitest run --passWithNoTests",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --check . --ignore-path ../../.gitignore",
        "preview": "vite preview --port 7576",
        "clean": "git clean -xdf node_modules .cache dist .turbo",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@brilliant/bds-core": "workspace:*",
        "@brilliant/components": "workspace:*",
        "@bv/api": "workspace:*",
        "@bv/design-tokens": "workspace:*",
        "@bv/graph-components": "workspace:*",
        "@bv/ui": "workspace:*",
        "@dagrejs/dagre": "3.1.1",
        "@fontsource/inter": "5.0.18",
        "@fontsource/rubik": "5.0.20",
        "@mdi/js": "7.4.47",
        "@mdi/react": "1.6.1",
        "@repo/prettier-config": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "@tanstack/react-table": "catalog:",
        "@types/lodash.debounce": "4.0.9",
        "@types/node": "catalog:",
        "@vitejs/plugin-react": "4.3.0",
        "@xyflow/react": "12.10.0",
        "ace-builds": "1.35.2",
        "axios": "1.13.4",
        "debounce": "2.1.0",
        "lodash.debounce": "4.0.8",
        "postcss": "8.4.39",
        "react": "catalog:",
        "react-ace": "12.0.0",
        "react-dom": "catalog:",
        "react-hook-form": "catalog:",
        "sass": "1.77.6",
        "tailwindcss": "catalog:",
        "vite-plugin-svgr": "4.2.0",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react-swc": "^3.5.0",
        "eslint": "^9.32.0",
        "eslint-plugin-react-refresh": "catalog:",
        "prettier": "catalog:",
        "react-router-dom": "^6.24.1",
        "@typescript/native": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vite": "catalog:"
    },
    "prettier": "@repo/prettier-config"
}
