# Used by Vite to proxy same-origin calls to "/api" to an actual backend instance. Example value here is the URL of
# brilliant_view_backend when running it locally.
VITE_API_URL="http://localhost:4000/api"

# Optional: skip auth only in the Vite dev server. Prefer `pnpm dev:arcade` for games.
# VITE_LOCAL_AUTH_BYPASS=false
