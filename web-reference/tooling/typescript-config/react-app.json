{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "React App",
    "extends": "./basev2.json",
    "compilerOptions": {
        "allowJs": true,
        "declaration": false,
        "declarationMap": false,
        "incremental": true,
        "jsx": "preserve",
        "lib": ["dom", "dom.iterable", "es2022"],
        "module": "esnext",
        "noEmit": true,
        "resolveJsonModule": true,
        "target": "es2022"
    }
}
