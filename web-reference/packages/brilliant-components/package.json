{
    "name": "@brilliant/components",
    "version": "0.8.3",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "types": "dist/src/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/main.d.ts",
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist/**"
    ],
    "dependencies": {
        "@bv/design-tokens": "workspace:*",
        "@mdx-js/mdx": "2.3.0",
        "@radix-ui/react-dialog": "1.0.5",
        "@radix-ui/react-label": "2.0.2",
        "@radix-ui/react-popover": "1.0.7",
        "@radix-ui/react-select": "1.2.2",
        "@radix-ui/react-slot": "1.0.2",
        "@radix-ui/react-tooltip": "1.0.7",
        "@rollup/plugin-typescript": "11.1.6",
        "class-variance-authority": "0.7.0",
        "clsx": "2.1.1",
        "generate-react-cli": "8.4.6",
        "lodash": "4.17.21",
        "sass": "1.77.2",
        "universal-cookie": "4.0.4",
        "vite-plugin-dts": "3.9.1",
        "@iconify/react": "4.1.1",
        "tailwind-merge": "2.3.0"
    },
    "devDependencies": {
        "@babel/core": "^7.21.4",
        "@babel/plugin-syntax-flow": "^7.21.4",
        "@babel/plugin-transform-react-jsx": "^7.21.0",
        "@iconify/tools": "^4.0.4",
        "@react-spring/web": "^9.7.2",
        "@storybook/addon-actions": "^7.0.2",
        "@storybook/addon-docs": "^7.0.2",
        "@storybook/addon-essentials": "^7.0.2",
        "@storybook/addon-interactions": "^7.0.2",
        "@storybook/addon-links": "^7.0.2",
        "@storybook/addon-mdx-gfm": "^7.0.2",
        "@storybook/blocks": "^7.0.2",
        "@storybook/builder-vite": "^7.6.16",
        "@storybook/cli": "^7.0.2",
        "@storybook/node-logger": "^7.0.2",
        "@storybook/react": "^7.6.16",
        "@storybook/react-vite": "^7.6.16",
        "@storybook/testing-library": "^0.2.2",
        "@swc/core": "^1.5.7",
        "@testing-library/dom": "^9.2.0",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/lodash": "^4.17.4",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "^4.2.1",
        "babel-plugin-named-exports-order": "^0.0.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.32.0",
        "jsdom": "^24.0.0",
        "postcss": "^8.3.11",
        "postcss-lit": "^1.1.0",
        "prettier": "catalog:",
        "prop-types": "^15.8.1",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-use": "catalog:",
        "storybook": "^7.0.2",
        "storybook-addon-root-attribute": "^1.0.2",
        "stylelint": "^15.3.0",
        "stylelint-config-standard": "^32.0.0",
        "stylelint-config-standard-scss": "^8.0.0",
        "stylelint-declaration-strict-value": "^1.9.2",
        "stylelint-itcss": "^0.4.0",
        "tsup": "^8.0.2",
        "@typescript/native": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-svgr": "^4.2.0",
        "vite-tsconfig-paths": "^4.3.1",
        "vitest": "^1.3.0"
    },
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-use": "catalog:"
    },
    "scripts": {
        "start": "vite",
        "dev": "cross-env NODE_ENV=development vite build --watch",
        "tsup-dev": "tsup src/main.ts --format esm,cjs --watch --dts --external react",
        "tsup-build": "tsup src/main.ts --format esm,cjs --dts --external react",
        "build": "tsc && vite build",
        "generate-static-assets": "vite build",
        "serve": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint . --max-warnings 0",
        "stylelint": "stylelint --config .stylelintrc **/*.scss",
        "verify": "pnpm eslint src && pnpm tsc && pnpm stylelint",
        "fix": "pnpm eslint --fix src && pnpm tsc && pnpm stylelint",
        "generate-css-variables": "npx tsx src/Theme/generateCSSVariables.ts",
        "clean": "git clean -xdf node_modules dist .turbo .cache",
        "typecheck": "tsc --noEmit"
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ],
        "overrides": [
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            },
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            "chrome >= 89",
            "firefox >= 89",
            "safari >= 15",
            "edge >= 89"
        ],
        "development": [
            "chrome >= 89",
            "firefox >= 89",
            "safari >= 15",
            "edge >= 89"
        ]
    },
    "author": "Sigve Røkenes <sigve.rokenes@brilliant.no>"
}
