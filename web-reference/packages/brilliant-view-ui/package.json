{
    "name": "@bv/ui",
    "version": "0.5.3",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./styles.css": "./dist/styles.css"
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --check . --ignore-path ../../.gitignore",
        "generate:component": "turbo gen react-component",
        "build": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
        "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
        "generate-static-assets": "vite build",
        "clean": "git clean -xdf node_modules dist .turbo .cache",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@brilliant/bds-core": "workspace:*",
        "@bv/api": "workspace:*",
        "@bv/design-tokens": "workspace:*",
        "@repo/eslint-config": "workspace:*",
        "@repo/prettier-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@storybook/react": "^7.6.16",
        "@tanstack/react-virtual": "^3.10.8",
        "@turbo/gen": "^1.12.4",
        "@types/eslint": "^8.56.5",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "autoprefixer": "^10.4.19",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "eslint": "^9.32.0",
        "postcss": "^8.4.38",
        "@storybook/test": "^7.6.17",
        "prettier": "catalog:",
        "react-hook-form": "catalog:",
        "react": "catalog:",
        "react-router-dom": "^6.24.1",
        "tailwindcss": "catalog:",
        "@typescript/native": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@storybook/react": "^7.6.16",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "class-variance-authority": "^0.7.0",
        "react": "catalog:",
        "react-router-dom": "^6.24.1"
    },
    "dependencies": {
        "@brilliant/components": "workspace:*",
        "@bv/i18n-utils": "workspace:*",
        "@bv/graph-components": "workspace:*",
        "@faker-js/faker": "8.4.1",
        "@radix-ui/react-accordion": "1.2.11",
        "@radix-ui/react-dialog": "1.0.5",
        "@radix-ui/react-tabs": "1.1.0",
        "@tanstack/react-table": "catalog:",
        "dayjs": "1.11.11",
        "tailwind-merge": "2.3.0",
        "tailwindcss-animate": "1.0.7",
        "zod": "3.23.8"
    },
    "prettier": "@repo/prettier-config"
}
